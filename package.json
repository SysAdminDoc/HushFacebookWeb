{
  "name": "hushfacebook-web",
  "version": "0.0.1",
  "description": "Userscript that takes ads, suggested posts and Meta AI out of facebook.com, with download, privacy and playback controls.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "SysAdminDoc",
  "repository": {
    "type": "git",
    "url": "https://github.com/SysAdminDoc/HushFacebookWeb.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-versions.mjs && eslint .",
    "lint": "eslint .",
    "release": "node scripts/release.mjs",
    "test": "node --test --test-timeout=30000 \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
