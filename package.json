{
  "name": "hushfacebook-web",
  "version": "0.0.7",
  "description": "Userscript that takes ads, suggested posts and Meta AI out of facebook.com, with download, privacy and playback controls.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "SysAdminDoc",
  "repository": {
    "type": "git",
    "url": "https://github.com/SysAdminDoc/HushFacebookWeb.git"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-versions.mjs && eslint .",
    "lint": "eslint .",
    "phrases": "node scripts/phrases.mjs",
    "release": "node scripts/release.mjs",
    "test": "node --test --test-concurrency=2 --test-timeout=30000 \"tests/**/*.test.js\"",
    "test:browser": "node tests/browser/runner.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright": "1.62.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "re2js": "2.9.0"
  }
}
